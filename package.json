{
  "name": "debate-timer",
  "version": "1.0.0",
  "description": "과학토론대회 타이머 (4팀)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.debate-timer.app",
    "productName": "과학토론타이머",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/afterPack.js",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "clock.html",
      "popup.html",
      "renderer.js",
      "clock.js",
      "popup.js",
      "styles.css"
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    }
  }
}
